# Copy to backend/.env and adjust. Never commit the real .env.

# --- Admin login (required to use the admin dashboard) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string, e.g. output of: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Storage: "dynamodb" (default) or "memory" (no AWS, data lost on restart) ---
STORE=dynamodb
AWS_REGION=ap-southeast-1
PRODUCTS_TABLE=aof-products
ORDERS_TABLE=aof-orders
IMAGES_BUCKET=aof-product-images
# Optional: CloudFront domain that serves the bucket, e.g. https://dxxxx.cloudfront.net
IMAGES_PUBLIC_BASE_URL=

# --- Local development without an AWS account ---
# Start the emulator first:  uv run moto_server -p 4566
# Remove this line to use your real AWS account (credentials from `aws configure`).
AWS_ENDPOINT_URL=http://localhost:4566

# Frontend origins allowed by CORS (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
